EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_JITSI_DOMAIN=
EXPO_PUBLIC_JITSI_BACKEND_URL=

# Expo SDK 58 replaced the global fetch with its own implementation, which
# rejects React Native's {uri} file uploads ("Unsupported FormDataPart
# implementation"). Keep RN's built-in fetch so document/photo uploads work.
# 1 = use RN fetch (recommended), 0/empty = use Expo's fetch.
EXPO_PUBLIC_USE_RN_FETCH=1
