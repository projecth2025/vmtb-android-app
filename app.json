{
  "expo": {
    "name": "vMTB",
    "slug": "vmtb",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "vmtb",
    "android": {
      "package": "com.harishbabu2007.vmtb",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-web-browser",
      "expo-audio",
      "expo-sharing",
      "expo-asset",
      "@config-plugins/react-native-webrtc",
      "./plugins/with-jitsi-gradle-plugin-version",
      "expo-status-bar"
    ],
    "owner": "harishbabu2007",
    "extra": {
      "eas": {
        "projectId": "42f4dd3c-4f9f-4365-a695-8f3e03eead93"
      }
    }
  }
}
